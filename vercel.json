{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/compile",
      "destination": "https://nizam-compiler-service.a.run.app/compile"
    }
  ],
  "headers": [
    {
      "source": "/wasm/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}
